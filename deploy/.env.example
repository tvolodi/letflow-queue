# letflow-queue — deploy environment template
# Copy to deploy/.env (same directory as the compose files) and fill in
# real values. Never commit the real .env to git.

# Shared bearer token every AI-agent host must present as
# `Authorization: Bearer <token>` on all endpoints except GET /health.
# Generate a random value, e.g.: openssl rand -hex 32
QUEUE_AUTH_TOKEN=

# Standard Phoenix release requirement — signs/encrypts cookies and other
# secrets. Generate with: mix phx.gen.secret (run inside the builder image
# or any local Elixir toolchain; this project has none of its own cookie
# usage today, but Phoenix's release boot still requires a value).
SECRET_KEY_BASE=

# Host this instance is served under (matches the nginx vhost's
# server_name — see deploy/nginx/). Used for URL generation only; the app
# does not enforce a Host allowlist beyond nginx's own vhost matching.
PHX_HOST=queue.ai-dala.com

# Optional — GitHub personal access token, enables best-effort two-way
# GitHub Issues sync (see README.md). Leave unset and the service runs
# fully without GitHub visibility; nothing else depends on this.
GITHUB_TOKEN=

# Optional — the "owner/repo" GitHub sync mirrors tasks to/from, e.g.
# tvolodi/letflow. Required alongside GITHUB_TOKEN for sync to activate;
# leave unset (with GITHUB_TOKEN) to disable sync entirely.
GITHUB_REPO=
